{
  "name": "m-erp-desktop-electron",
  "version": "1.0.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": {
    "name": "Shree Mahakali Agro Feed",
    "email": "akashmahakali144@gmail.com"
  },
  "homepage": "http://127.0.0.1:8000",
  "license": "ISC",
  "description": "M ERP Desktop Application",
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.merp.desktop",
    "productName": "M ERP",
    "asar": true,
    "icon": "build/erp-logo.ico",


    "files": [
      "**/*",
      "!data/**/*",
      "!dist/**/*",
      "!database-template/**/*",
      "!runtime/**/*",
      "!.git/**/*",
      "!**/*.map",
      "!**/node_modules/.cache/**/*"
    ],

    "publish": {
      "provider": "github",
      "owner": "joshi-akash-144",
      "repo": "m-erp-desktop",
      "releaseType": "release"
    },
    
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/.git/**/*",
          "!**/tests/**/*",
          "!**/storage/logs/**/*",
          "!**/storage/framework/cache/**/*",
          "!**/storage/framework/sessions/**/*",
          "!**/storage/framework/views/**/*",
          "!**/node_modules/**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "database-template",
        "to": "database-template",
        "filter": [
          "**/*",
          "!**/.git/**/*"
        ]
      }

    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office"
    }
  },

  

  "allowScripts": {
    "electron@41.10.7": true
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
